# Generated by scripts/release.py from the automation branch (main); do not
# edit on a patch branch: it is regenerated on every replay.
#
# Upstream's .github is removed on patch branches. This stub only calls the
# fork's build workflow (build, unit tests, e2e; never publishes) as it is on
# main, so CI logic lives in one place.
name: ci

on:
  push:
    branches: ["oidc/**"]
  pull_request:
    branches: ["oidc/**"]

permissions: {}

jobs:
  gate:
    uses: @GITHUB_REPO@/.github/workflows/build.yml@main
    permissions:
      contents: read
    with:
      src_ref: ${{ github.event.pull_request.head.sha || github.sha }}
